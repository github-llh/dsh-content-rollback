{
  "name": "dsh-content-rollback",
  "version": "0.1.1",
  "description": "Recover and resend sent content in the same DSH conversation, with byte-verified local backups.",
  "type": "module",
  "main": "./index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "src/host", "client", "locale", "icon.svg", "cordis.patch.yml"],
  "engines": { "node": ">=22.19.0", "dsh": ">=0.2.1-rc.2 <0.2.2" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.js",
    "verify": "node scripts/verify.mjs",
    "check": "npm run build && npm test && npm run verify"
  },
  "devDependencies": { "esbuild": "0.25.12" },
  "dsh": {
    "manifestVersion": 1,
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-locale"]
    }
  }
}
